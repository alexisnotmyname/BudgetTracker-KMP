CREATE TABLE BudgetTransactionEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    amount REAL NOT NULL,
    paymentMethod TEXT NOT NULL,
    category TEXT NOT NULL,
    note TEXT NOT NULL,
    budgetItemType TEXT NOT NULL,
    dateTimeCreated INTEGER,
    dateTimeUpdated INTEGER,
    remainingBalance REAL
);

selectBudgetTransactionById:
SELECT * FROM BudgetTransactionEntity WHERE id = ?;

getAllBudgetTransactions:
SELECT * FROM BudgetTransactionEntity ORDER BY dateTimeCreated ASC;

insertBudgetTransaction:
INSERT INTO BudgetTransactionEntity(amount, paymentMethod, category, note, budgetItemType, dateTimeCreated, dateTimeUpdated, remainingBalance)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateBudgetTransaction:
UPDATE BudgetTransactionEntity
SET amount = ?, paymentMethod = ?, category = ?, note = ?, budgetItemType = ?, dateTimeUpdated = ?, remainingBalance = ?
WHERE id = ?;

deleteBudgetTransaction:
DELETE FROM BudgetTransactionEntity WHERE id = ?;
